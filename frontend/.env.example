# Frontend environment variables (example — no real secrets)
# Copy to .env and fill in for your environment.
#
# NOTE: In the Emergent workspace, EXPO_PACKAGER_PROXY_URL / EXPO_PACKAGER_HOSTNAME /
# EXPO_TUNNEL_SUBDOMAIN / METRO_CACHE_ROOT are injected by the platform to build the
# mobile + web preview URLs. When rebuilding OUTSIDE the workspace you typically do not
# need these — Expo will generate its own dev URLs. Only EXPO_PUBLIC_BACKEND_URL matters
# for talking to your API.

# Base URL of the backend. The app appends "/api" to this for all requests.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# --- Platform-managed in the Emergent preview (safe to omit in a local rebuild) ---
EXPO_TUNNEL_SUBDOMAIN=
EXPO_PACKAGER_HOSTNAME=
EXPO_PACKAGER_PROXY_URL=
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=
