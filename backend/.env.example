# Backend environment variables (example — no real secrets)
# Copy to .env and fill in your own values.

# MongoDB connection string (local or hosted)
MONGO_URL=mongodb://localhost:27017

# Database name used by the app
DB_NAME=masl_ticker

# Emergent Universal LLM key — powers the Talk booth (Rayo/Casey chat replies).
# In a standalone rebuild, replace with your own LLM provider key/setup.
EMERGENT_LLM_KEY=your-llm-key-here

# ElevenLabs API key — powers host text-to-speech (cold open, per-page banter, Talk).
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
